# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# Project root URL — note: NOT the /rest/v1/ endpoint.
VITE_SUPABASE_URL="https://your-project.supabase.co"

# anon / publishable key. Safe to ship: it is compiled into the browser bundle
# and every table is protected by row-level security.
# NEVER put the service_role / sb_secret_ key here — it bypasses RLS entirely,
# and this is a client-side app, so anyone could read it out of the bundle.
VITE_SUPABASE_ANON_KEY=""

# RevenueCat public SDK keys (Dashboard → Project → API keys → App-specific).
# Safe to ship: these are public client keys, like the Supabase anon key.
# The secret key belongs only in server-side webhook handlers, never here.
VITE_REVENUECAT_IOS_KEY=""
VITE_REVENUECAT_ANDROID_KEY=""

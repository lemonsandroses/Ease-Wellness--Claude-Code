# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# Project root URL — note: NOT the /rest/v1/ endpoint.
VITE_SUPABASE_URL="https://your-project.supabase.co"

# anon / publishable key. Safe to ship: it is compiled into the browser bundle
# and every table is protected by row-level security.
# NEVER put the service_role / sb_secret_ key here — it bypasses RLS entirely,
# and this is a client-side app, so anyone could read it out of the bundle.
VITE_SUPABASE_ANON_KEY=""

# RevenueCat public SDK keys (Dashboard → Project → API keys → App-specific).
# Safe to ship: these are public client keys, like the Supabase anon key.
# The secret key belongs only in server-side webhook handlers, never here.
VITE_REVENUECAT_IOS_KEY=""
VITE_REVENUECAT_ANDROID_KEY=""

# Where confirmation and password-reset links land. Leave blank for web (the
# current origin is used). For the iOS/Android builds set an https page you
# control and add the same URL under Supabase → Authentication → URL
# Configuration → Redirect URLs; without it links fall back to the Site URL.
VITE_AUTH_REDIRECT_URL=""

# Sign in with Google. iOS uses the iOS OAuth client; the web client id is also
# what Supabase → Authentication → Providers → Google expects as "Client ID".
# Leaving these blank hides the Google button rather than failing on tap.
VITE_GOOGLE_IOS_CLIENT_ID=""
VITE_GOOGLE_WEB_CLIENT_ID=""

# Sign in with Apple. Only needed for the web and Android flows — on iOS the
# app signs in against its own bundle id. This is the Service ID (not the App
# ID), e.g. com.easewellness.app.signin
VITE_APPLE_SERVICE_ID=""
